@inject IHabitService HabitService

<div class="modal fade @(_visible ? "show d-block" : "")" tabindex="-1" style="@(_visible ? "background:rgba(15,17,35,.45);" : "")">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">@(_isEdit ? "Edit Habit" : "Add New Habit")</h5>
                <button type="button" class="btn-close" @onclick="Close"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="_habit" OnValidSubmit="Save">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Habit Name</label>
                        <InputText class="form-control" @bind-Value="_habit.Name" placeholder="e.g. Read 20 pages" />
                        <ValidationMessage For="() => _habit.Name" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Monthly Goal (days)</label>
                        <InputNumber class="form-control" @bind-Value="_habit.MonthlyGoal" min="1" max="31" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Color</label>
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (var color in _palette)
                            {
                                <span class="color-swatch @(_habit.ColorHex == color ? "selected" : "")"
                                      style="background:@color;" @onclick="() => _habit.ColorHex = color"></span>
                            }
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold">Icon</label>
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (var icon in _icons)
                            {
                                <span class="icon-swatch @(_habit.Icon == icon ? "selected" : "")"
                                      @onclick="() => _habit.Icon = icon">
                                    <i class="bi @icon"></i>
                                </span>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-light" @onclick="Close">Cancel</button>
                        <button type="submit" class="btn btn-brand px-4">@(_isEdit ? "Save Changes" : "Add Habit")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _visible = false;
    private bool _isEdit = false;
    private Habit _habit = new();

    private readonly string[] _palette =
    {
        "#f4a825", "#2e86de", "#e74c3c", "#27ae60", "#8e44ad",
        "#16a085", "#e67e22", "#2c3e50", "#d63384", "#0d9488"
    };

    private readonly string[] _icons =
    {
        "bi-droplet-fill", "bi-book-fill", "bi-trophy-fill", "bi-cup-hot-fill",
        "bi-bicycle", "bi-heart-pulse-fill", "bi-moon-stars-fill", "bi-brush-fill",
        "bi-journal-text", "bi-piggy-bank-fill", "bi-emoji-smile-fill", "bi-check2-circle"
    };

    public void ShowForNew()
    {
        _habit = new Habit { ColorHex = _palette[0], Icon = _icons[0], MonthlyGoal = 30 };
        _isEdit = false;
        _visible = true;
        StateHasChanged();
    }

    public void ShowForEdit(Habit habit)
    {
        _habit = new Habit
        {
            Id = habit.Id,
            Name = habit.Name,
            ColorHex = habit.ColorHex,
            Icon = habit.Icon,
            MonthlyGoal = habit.MonthlyGoal,
            SortOrder = habit.SortOrder,
            IsActive = habit.IsActive,
            CreatedAt = habit.CreatedAt
        };
        _isEdit = true;
        _visible = true;
        StateHasChanged();
    }

    private void Close()
    {
        _visible = false;
    }

    private async Task Save()
    {
        if (_isEdit)
        {
            await HabitService.UpdateHabitAsync(_habit);
        }
        else
        {
            await HabitService.AddHabitAsync(_habit);
        }

        _visible = false;
        await OnSaved.InvokeAsync();
    }
}
